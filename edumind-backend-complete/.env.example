PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/edumind
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Optional. If omitted, EduMind uses a local fallback AI so the app can still run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
